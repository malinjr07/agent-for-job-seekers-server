// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @db.VarChar(255)
  firstName       String     @db.VarChar(100)
  lastName        String     @db.VarChar(100)
  handle          String?    @unique @db.VarChar(50)
  status          UserStatus @default(VERIFICATION_PENDING)
  statusUpdatedAt DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  leadSources    LeadSources[]
  emailTemplates EmailTemplate[]
  resumes        Resume[]
  mailLogs       MailLog[]
  leads          Lead[]
}

model LeadSources {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  sourceType SourceType
  sourceUri  String   @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headers Header[]
  leads   Lead[]
}

model Header {
  id             String @id @default(uuid(7)) @db.Uuid
  leadSourceId   String @db.Uuid
  tabName        String? @db.VarChar(100)
  headers        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leadSource LeadSources @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id           String     @id @default(uuid(7)) @db.Uuid
  userId       String     @db.Uuid
  name         String     @db.VarChar(255)
  templateBody String     @db.Text
  variables    Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailLogs MailLog[]
  resumes  Resume[]  @relation("TemplateResumes")
}

model Resume {
  id          String          @id @default(uuid(7)) @db.Uuid
  userId      String          @db.Uuid
  name        String          @db.VarChar(255)
  htmlContent String          @db.Text
  pdfPath     String?         @db.Text
  variables   Json?
  templateId  String?         @db.Uuid
  createdAt   DateTime        @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template EmailTemplate?  @relation("TemplateResumes", fields: [templateId], references: [id])
  sections ResumeSection[]
  mailLogs MailLog[]
}

model ResumeSection {
  id          String  @id @default(uuid(7)) @db.Uuid
  resumeId    String  @db.Uuid
  sectionType String  @db.VarChar(50)
  content     Json
  orderIndex  Int

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model MailLog {
  id              String      @id @default(uuid(7)) @db.Uuid
  userId          String      @db.Uuid
  emailTemplateId String      @db.Uuid
  resumeId        String?     @db.Uuid
  recipientEmail  String      @db.VarChar(255)
  status          MailStatus
  sentAt          DateTime?
  errorMessage    String?     @db.Text

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailTemplate EmailTemplate @relation(fields: [emailTemplateId], references: [id], onDelete: Cascade)
  resume        Resume?       @relation(fields: [resumeId], references: [id], onDelete: SetNull)
}

model Lead {
  id            String @id @default(uuid(7)) @db.Uuid
  userId        String @db.Uuid
  leadSourceId  String @db.Uuid
  firstName     String? @db.VarChar(255)
  lastName      String? @db.VarChar(255)
  fullName      String? @db.VarChar(255)
  emailAddress  String @unique @db.VarChar(255)
  companyName   String @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadSource  LeadSources @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)
}

model EmailFlag {
  id          String     @id @default(uuid(7)) @db.Uuid
  email       String     @unique @db.VarChar(255)
  score       Int
  flag        FlagStatus
  lastUpdated DateTime   @default(now())
}

enum UserStatus {
  ACTIVE
  VERIFICATION_PENDING
  DISABLED
  HIBERNATED
  DELETED
}

enum MailStatus {
  SENT
  FAILED
  PENDING
}

enum SourceType {
  GOOGLE_SHEET
  CSV
  SPREADSHEET
  JSON
}

enum FlagStatus {
  GREEN
  YELLOW
  RED
}
